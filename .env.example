# VN Terminal Pro - local environment configuration
#
# Copy to .env and fill in values. Never commit .env (Section 20 of
# vn_terminal_multi_ai_development_plan.md v1.1: "Never commit .env").
# API keys must stay server-side and must never reach browser code, prompts,
# or logs (Section 18.2, Section 18.4).
#
# The exact variable names below are not specified in the plan and are an
# implementation choice of this session. See contracts/OPEN_ITEMS.md,
# "Environment variable names."

# --- Application binding (Section 3.1: bind to 127.0.0.1, not exposed publicly) ---
VN_TERMINAL_HOST=127.0.0.1
VN_TERMINAL_PORT=8000

# --- Local data source (Section 3.1, Section 19.1) ---
# Read-only. The application must never open files under this root in write
# mode (Section 20: "Do not modify files under C:\FDATA\AmiBroker").
FDATA_ROOT=C:\FDATA\AmiBroker

# --- Canonical storage (Section 7: DuckDB + Parquet) ---
DUCKDB_PATH=./data/canonical/vn_terminal.duckdb
SNAPSHOT_DIR=./data/snapshots

# --- AI gateway adapters (Section 18.2) ---
# Cloud adapter: OpenRouter-compatible.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local adapter: Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional direct OpenAI-compatible adapter (Section 18.2: "Optional direct
# OpenAI-compatible adapter").
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# Default provider for /api/ai/analyze when the request omits model_config.
# One of: openrouter, ollama, openai_compatible.
# Open question 4 in Section 30 of the plan ("Should cloud AI be enabled by
# default, or should Ollama be the default?") is not yet answered; defaulting
# to the zero-marginal-cost local option until the user decides.
AI_DEFAULT_PROVIDER=ollama

# --- Logging (Section 20: maintain an audit log of AI model, prompt version,
# data version, and timestamp) ---
LOG_LEVEL=info
AUDIT_LOG_PATH=./data/quality_reports/ai_audit_log.jsonl
